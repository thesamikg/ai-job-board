# Supabase configuration
# Get these from Project Settings -> API in your Supabase dashboard
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Do not expose this with a VITE_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated admin emails who can open Admin Dashboard
VITE_ADMIN_EMAILS=saminathank1999@gmail.com

# PostHog browser analytics
VITE_POSTHOG_PROJECT_TOKEN=ph_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Dodo Payments server-side configuration
# Use https://test.dodopayments.com while testing and https://live.dodopayments.com in production
DODO_PAYMENTS_API_KEY=your-dodo-payments-api-key
DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com
